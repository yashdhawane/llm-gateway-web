# Copy to .env.local. Only public values belong here: anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle at build time, so a secret in
# this file would be shipped to every visitor.

# Gateway base URL, including the version segment. The gateway listens on 4000;
# this app keeps the conventional 3000.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
